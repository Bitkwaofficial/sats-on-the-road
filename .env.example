# Environment variables for the serverless functions in api/.
# Set the real values in the Vercel project (Settings -> Environment Variables).
# NEVER commit real values. Copy this file to .env.local for local work and keep it out of git.

# Wall of Support store (Upstash Redis / Vercel KV). Either the KV_ or UPSTASH_ names work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin token for the private wall moderation endpoints (/api/wall/moderate, /pending, /approved).
# A long random secret. The admin page sends it as the x-admin-token header.
ADMIN_TOKEN=

# The waitlist (/join) posts to a Google Apps Script web app. The script holds the Sheet ID
# and runs server-side under the Apps Script project, NOT here. Nothing to set in this repo.
