{
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "redirects": [
    { "source": "/fuelthetruck", "destination": "/fuel", "permanent": true },
    { "source": "/impact", "destination": "/mission", "permanent": true },
    { "source": "/volunteer", "destination": "/contact", "permanent": true }
  ]
}
